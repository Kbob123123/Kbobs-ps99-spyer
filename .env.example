DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: set this for instant slash-command updates in one server while
# developing. Leave blank to register globally (takes up to an hour to appear).
DISCORD_GUILD_ID=

# Where the SQLite database lives. On Railway point this at a mounted volume
# (e.g. /data/spyer.db) or all collected history is lost on every redeploy.
DB_PATH=./data/spyer.db

# Optional, defaults to 10.
POLL_INTERVAL_MINUTES=10
