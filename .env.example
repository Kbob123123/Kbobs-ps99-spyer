DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: set this for instant command updates in one server during development.
# Leave blank to register commands globally (takes up to 1 hour to propagate to
# all servers the bot is in).
GUILD_ID=

# Channel routing (huge/titanic/gargantuan tracker, RAP alerts, exists alerts)
# is no longer set here. Each server configures its own channels in Discord
# using the /config command after inviting the bot. See SETUP-SERVER.txt.
